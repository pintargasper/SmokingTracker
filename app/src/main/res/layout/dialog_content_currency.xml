<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="TextSizeCheck">

    <LinearLayout
        android:id="@+id/currency_options_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkbox_euro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/currency_check_box_euro"
            android:maxWidth="300dp"
            style="?appCheckBoxStyle"
            tools:ignore="VisualLintButtonSize,VisualLintSystemUi" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkbox_dollar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/currency_check_box_dollar"
            android:maxWidth="300dp"
            style="?appCheckBoxStyle"
            tools:ignore="HardcodedText,VisualLintButtonSize" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkbox_pound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/currency_check_box_pound"
            android:maxWidth="300dp"
            style="?appCheckBoxStyle"
            tools:ignore="HardcodedText,VisualLintButtonSize" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/edit_text_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="@string/currency_text_error"
            android:scrollHorizontally="false"
            android:visibility="gone"
            style="?appBodyStyle" />

        <LinearLayout
            android:id="@+id/custom_currency_input_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkbox_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/currency_check_box_custom"
                style="?appCheckBoxStyle"
                tools:ignore="HardcodedText,VisualLintButtonSize" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:hint="@string/currency_check_box_edit_description"
                style="?appTextInputLayoutStyle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_custom_currency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:autofillHints="none"
                    android:inputType="text"
                    android:layout_marginStart="4dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    style="?appEditTextStyle" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>