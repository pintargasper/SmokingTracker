<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragment.statistics.BasicFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:text="@string/statistics_title_cigarettes_section"
            style="?appTitleStyle"
            tools:ignore="VisualLintSystemUi" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/cigarettes_view_pager"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="horizontal"
            android:overScrollMode="never" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/cigarettes_page_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1 / 6"
            style="?appCaptionStyle"
            tools:ignore="HardcodedText" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:text="@string/statistics_title_money_section"
            style="?appTitleStyle" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/statistics_title_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"

            android:gravity="start"
            android:text="@string/statistics_title_money_section_instructions"
            android:visibility="visible"
            style="?appBodyStyle" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/money_view_pager"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="horizontal"
            android:overScrollMode="never" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/money_page_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1 / 4"
            style="?appCaptionStyle"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>