<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/achievement_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/achievement_row_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/image_achievement"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/achievements_icon"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerInside" />

        <LinearLayout
            android:id="@+id/achievement_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/achievement_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:ellipsize="end"
                style="?appTitleStyle" />

            <TextView
                android:id="@+id/achievement_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                style="?appBodyStyle" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/last_achieved"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/achievement_last"
        android:alpha="0.6"
        style="?appBodyStyle" />

    <TextView
        android:id="@+id/achieved_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/achievement_achieved"
        android:alpha="0.6"
        style="?appBodyStyle" />

</LinearLayout>