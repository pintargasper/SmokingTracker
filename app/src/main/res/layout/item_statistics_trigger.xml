<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/trigger_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        tools:src="@drawable/psychology_48px" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/trigger_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="?appBodyStyle"
                tools:text="Stress"
                tools:ignore="VisualLintSystemUi" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/trigger_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                style="?appSubtitleStyle"
                tools:text="35%"
                tools:ignore="VisualLintSystemUi" />

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/trigger_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="35"
            style="?appProgressBarStyle"
            app:trackThickness="5dp"
            tools:progress="35" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/trigger_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            style="?appCaptionStyle"
            tools:text="24 cigarettes" />

    </LinearLayout>

</LinearLayout>