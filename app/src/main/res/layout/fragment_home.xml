<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_counter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/timer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%1$02d:%2$02d:%3$02d"
                style="@style/SpecialTitleTextView"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/timer_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_timer_message"
                style="@style/BodyTextView"
                android:gravity="center"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/layout_timeline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/card_counter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="5dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="12dp">

                <com.gasperpintar.smokingtracker.ui.MarqueeTextView
                    android:id="@+id/daily_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_daily"
                    style="@style/SubtitleTextView"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOnSurface"/>

                <TextView
                    android:id="@+id/daily_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    style="@style/BodyTextView"
                    android:singleLine="true"
                    android:ellipsize="end"
                    tools:ignore="HardcodedText" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="5dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="12dp">

                <com.gasperpintar.smokingtracker.ui.MarqueeTextView
                    android:id="@+id/weekly_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_weekly"
                    style="@style/SubtitleTextView" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/weekly_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    style="@style/BodyTextView"
                    android:singleLine="true"
                    android:ellipsize="end"
                    tools:ignore="HardcodedText" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="5dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="12dp">

                <com.gasperpintar.smokingtracker.ui.MarqueeTextView
                    android:id="@+id/monthly_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_monthly"
                    style="@style/SubtitleTextView"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOnSurface"/>

                <TextView
                    android:id="@+id/monthly_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    style="@style/BodyTextView"
                    android:singleLine="true"
                    android:ellipsize="end"
                    tools:ignore="HardcodedText" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_day_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:layout_marginHorizontal="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/layout_timeline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/day_navigation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/previous_day"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/home_previous_day"
                android:src="@drawable/arrow_circle_left_48px"
                android:padding="0dp"
                app:tint="?attr/colorOnSurface"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="170dp"
                android:layout_marginHorizontal="8dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/current_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Day"
                    android:gravity="center"
                    style="@style/SubtitleTextView"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/current_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%1$02d.%2$02d.%3$d"
                    android:gravity="center"
                    android:layout_marginTop="-5dp"
                    style="@style/MainTitleCenterTextView"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/next_day"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/home_next_day"
                android:src="@drawable/arrow_circle_right_48px"
                android:padding="0dp"
                app:tint="?attr/colorOnSurface"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_recyclerview_history"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="8dp"
        android:layout_marginHorizontal="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/card_day_navigation"
        app:layout_constraintBottom_toTopOf="@id/card_button_add_entry"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/layout_empty_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/empty_history_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_no_entries"
                android:gravity="center"
                style="@style/MainTitleCenterTextView" />

            <TextView
                android:id="@+id/empty_history_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_no_entries_message"
                android:gravity="center"
                style="@style/BodyTextView" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_button_add_entry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/button_add_entry"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:contentDescription="@string/home_next_day"
            android:text="@string/home_add_entry"
            style="@style/Button"/>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>