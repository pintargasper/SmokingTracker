<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layout_total_costs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/label_total_costs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="@string/calculator_result_total"
            style="?appSubtitleStyle"
            tools:ignore="VisualLintSystemUi" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/total_costs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?appBodyStyle" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_cost_per_cigarette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/label_cost_per_cigarette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="@string/calculator_result_cost"
            style="?appSubtitleStyle" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/cost_per_cigarette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?appBodyStyle" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_average_cost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/label_average_cost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="@string/calculator_result_average_cost"
            style="?appSubtitleStyle" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/average_cost_per_hour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?appBodyStyle" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_time_spent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/label_time_spent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="@string/calculator_result_time_spent"
            style="?appSubtitleStyle" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/time_spent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?appBodyStyle" />

    </LinearLayout>

    <View
        android:id="@+id/view_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_margin="8dp"
        android:background="?attr/colorOnSurface" />

    <LinearLayout
        android:id="@+id/layout_average_time_per_cigarette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/label_average_time_per_cigarette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="@string/calculator_result_average_time"
            style="?appSubtitleStyle" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/popup_result_average_time_per_cigarette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calculator_result_estimated_time"
            style="?appBodyStyle" />

    </LinearLayout>

</LinearLayout>