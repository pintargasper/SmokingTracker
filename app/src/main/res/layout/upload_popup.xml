<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_upload_popup_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    style="@style/Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/popup_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/restore_popup"
            android:gravity="center"
            style="@style/MainTitleCenterTextView" />

        <TextView
            android:id="@+id/popup_notification_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/restore_popup_info"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            style="@style/BodyTextView" />

        <LinearLayout
            android:id="@+id/open_file_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp">

            <TextView
                android:id="@+id/text_selected_file"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                android:text="@string/restore_popup_file"
                android:ellipsize="end"
                android:singleLine="true"
                style="@style/BodyTextView" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_open_file_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.3"
                android:layout_margin="8dp"
                android:padding="8dp"
                style="@style/Card">

                <Button
                    android:id="@+id/open_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/popup_select"
                    style="@style/Button" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:layout_marginHorizontal="16dp"
            style="@style/Card">

            <Button
                android:id="@+id/confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/popup_confirm"
                style="@style/Button"
                tools:ignore="VisualLintButtonSize" />

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            style="@style/Card">

            <Button
                android:id="@+id/close"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/popup_close"
                style="@style/Button"
                tools:ignore="VisualLintButtonSize" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.cardview.widget.CardView>