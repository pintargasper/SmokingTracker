<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_result_popup_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    style="@style/Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/popup_result_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calculator_result"
            style="@style/MainTitleCenterTextView" />

        <LinearLayout
            android:id="@+id/layout_total_costs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label_total_costs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="@string/calculator_result_total"
                style="@style/SubtitleTextView" />

            <TextView
                android:id="@+id/popup_result_total_costs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                style="@style/BodyTextView" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_cost_per_cigarette"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label_cost_per_cigarette"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="@string/calculator_result_cost"
                style="@style/SubtitleTextView" />

            <TextView
                android:id="@+id/popup_result_cost_per_cigarette"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                style="@style/BodyTextView" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_average_cost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label_average_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="@string/calculator_result_average_cost"
                style="@style/SubtitleTextView" />

            <TextView
                android:id="@+id/popup_result_average_cost_per_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                style="@style/BodyTextView" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_time_spent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label_time_spent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="@string/calculator_result_time_spent"
                style="@style/SubtitleTextView" />

            <TextView
                android:id="@+id/popup_result_time_spent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                style="@style/BodyTextView" />

        </LinearLayout>

        <View
            android:id="@+id/view_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_margin="8dp"
            android:background="?attr/colorOnSurface" />

        <LinearLayout
            android:id="@+id/layout_average_time_per_cigarette"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label_average_time_per_cigarette"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="@string/calculator_result_average_time"
                style="@style/SubtitleTextView" />

            <TextView
                android:id="@+id/popup_result_average_time_per_cigarette"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calculator_result_estimated_time"
                style="@style/BodyTextView" />

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_confirm_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:layout_marginHorizontal="16dp"
            style="@style/Card">

            <Button
                android:id="@+id/close"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/popup_close"
                style="@style/Button"
                tools:ignore="VisualLintButtonSize" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.cardview.widget.CardView>