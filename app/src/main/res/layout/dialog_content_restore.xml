<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/open_file_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/text_selected_file"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:text="@string/restore_popup_file"
        android:ellipsize="end"
        android:singleLine="true"
        style="?appBodyStyle"
        tools:ignore="VisualLintSystemUi" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_file"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0.2"
        android:text="@string/popup_select"
        style="?appButtonStyle"
        tools:ignore="VisualLintButtonSize,VisualLintSystemUi" />

</LinearLayout>