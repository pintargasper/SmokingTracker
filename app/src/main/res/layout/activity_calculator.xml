<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back to previous screen"
            android:src="@drawable/arrow_circle_left_48px"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurface"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:text="@string/more_tools_calculator"
            style="@style/MainTitleCenterTextView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/colorSurface"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/card_calculator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/text_daily_cigarettes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/calculator_per_day"
                        style="@style/SubtitleTextView" />

                    <EditText
                        android:id="@+id/input_daily_cigarettes"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:autofillHints="0"
                        android:hint="0"
                        android:inputType="number"
                        style="@style/EditText"
                        tools:ignore="HardcodedText,VisualLintTextFieldSize" />

                    <TextView
                        android:id="@+id/text_cigarettes_per_pack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/calculator_per_pack"
                        style="@style/SubtitleTextView" />

                    <EditText
                        android:id="@+id/input_cigarettes_per_pack"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:autofillHints="20"
                        android:hint="20"
                        android:inputType="number"
                        style="@style/EditText"
                        tools:ignore="HardcodedText,VisualLintTextFieldSize" />

                    <TextView
                        android:id="@+id/text_pack_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/calculator_price"
                        style="@style/SubtitleTextView" />

                    <EditText
                        android:id="@+id/input_pack_price"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:autofillHints="0.00"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        style="@style/EditText"
                        tools:ignore="HardcodedText,VisualLintTextFieldSize" />

                    <TextView
                        android:id="@+id/text_period"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/calculator_period"
                        style="@style/SubtitleTextView" />

                    <LinearLayout
                        android:id="@+id/layout_date_range_picker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_start_date_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/calculator_from"
                            style="@style/BodyTextView" />

                        <EditText
                            android:id="@+id/input_start_date"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="false"
                            android:hint="@string/calculator_start_date"
                            android:autofillHints="@string/calculator_start_date"
                            android:inputType="date"
                            style="@style/EditText"
                            tools:ignore="VisualLintTextFieldSize" />

                        <TextView
                            android:id="@+id/text_end_date_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/calculator_to"
                            style="@style/BodyTextView" />

                        <EditText
                            android:id="@+id/input_end_date"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="false"
                            android:hint="@string/calculator_end_date"
                            android:autofillHints="@string/calculator_end_date"
                            android:inputType="date"
                            style="@style/EditText"
                            tools:ignore="VisualLintTextFieldSize" />

                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_button_calculate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="4dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp">

                        <Button
                            android:id="@+id/button_calculate"
                            android:layout_width="wrap_content"
                            android:layout_height="55dp"
                            android:text="@string/calculator_calculate"
                            style="@style/Button" />

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>