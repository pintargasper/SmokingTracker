<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_notifications_popup_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    style="@style/Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/popup_notifications_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notifications_popup"
            style="@style/MainTitleCenterTextView" />

        <TextView
            android:id="@+id/popup_notifications_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notifications_popup_info"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            style="@style/BodyTextView" />

        <ScrollView
            android:id="@+id/notifications_inner_options_container"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="16dp"
            android:fillViewport="true"
            tools:ignore="TextSizeCheck">

            <LinearLayout
                android:id="@+id/notifications_options_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/notifications_options_container_system"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <CheckBox
                        android:id="@+id/checkbox_system"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/notifications_popup_check_box_system"
                        android:maxWidth="300dp"
                        style="@style/CheckBox" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/notifications_options_container_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <CheckBox
                        android:id="@+id/checkbox_progress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/notifications_popup_check_box_progress"
                        style="@style/CheckBox" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/label_frequency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/notifications_popup_frequency_label"
                            android:labelFor="@+id/spinner_progress_frequency"
                            style="@style/BodyTextView" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            app:hintEnabled="false"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                            <AutoCompleteTextView
                                android:id="@+id/spinner_progress_frequency"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:focusable="false"
                                android:clickable="false"
                                android:cursorVisible="false"
                                android:inputType="none"
                                app:simpleItems="@array/frequency_options"
                                tools:ignore="LabelFor"
                                style="@style/BodyTextView" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/notifications_options_container_achievements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <CheckBox
                        android:id="@+id/checkbox_achievements"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxWidth="300dp"
                        android:text="@string/notifications_popup_check_box_achievements"
                        style="@style/CheckBox"
                        tools:ignore="VisualLintButtonSize" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:layout_marginHorizontal="16dp"
            style="@style/Card">

            <Button
                android:id="@+id/close"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/popup_close"
                style="@style/Button" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.cardview.widget.CardView>