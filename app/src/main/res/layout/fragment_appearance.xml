<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.fragment.AppearanceFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Back to previous screen"
            style="?appImageButtonStyle"
            app:icon="@drawable/arrow_circle_left_48px"
            tools:ignore="HardcodedText,VisualLintSystemUi" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_general_theme"
            style="?appTitleSpecialStyle"
            tools:ignore="VisualLintSystemUi" />

        <Space
            android:layout_width="56dp"
            android:layout_height="1dp" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="3dp"
                android:text="@string/settings_general"
                style="?appTitleStyle"
                tools:ignore="VisualLintSystemUi" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="5dp"
                style="?appCardStyle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="55dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="5dp"
                    android:paddingEnd="12dp"
                    android:paddingVertical="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_appearance_theme"
                        android:labelFor="@id/theme_dropdown"
                        style="?appSubtitleStyle" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/theme_dropdown_layout"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:hintEnabled="false"
                        app:endIconMode="dropdown_menu"
                        style="?appTextInputLayoutStyle">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/theme_dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:focusable="false"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:inputType="none"
                            app:simpleItems="@array/appearance_theme_options"
                            tools:ignore="LabelFor"
                            style="?appDropdownStyle" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="5dp"
                style="?appCardStyle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="55dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="5dp"
                    android:paddingEnd="12dp"
                    android:paddingVertical="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_appearance_scheme"
                        android:labelFor="@id/scheme_dropdown"
                        style="?appSubtitleStyle" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/scheme_dropdown_layout"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:hintEnabled="false"
                        app:endIconMode="dropdown_menu"
                        style="?appTextInputLayoutStyle">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/scheme_dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:focusable="false"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:inputType="none"
                            app:simpleItems="@array/appearance_scheme_options"
                            tools:ignore="LabelFor"
                            style="?appDropdownStyle" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                style="?appCardStyle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="55dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="5dp"
                    android:paddingEnd="12dp"
                    android:paddingVertical="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_appearance_start_page"
                        android:labelFor="@id/start_page_dropdown"
                        style="?appSubtitleStyle" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/start_page_dropdown_layout"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:hintEnabled="false"
                        app:endIconMode="dropdown_menu"
                        style="?appTextInputLayoutStyle">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/start_page_dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:focusable="false"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:inputType="none"
                            app:simpleItems="@array/appearance_start_page_options"
                            tools:ignore="LabelFor"
                            style="?appDropdownStyle" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>