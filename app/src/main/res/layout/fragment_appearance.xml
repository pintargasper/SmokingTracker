<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.fragment.AppearanceFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Back to previous screen"
            style="?appImageButtonStyle"
            app:icon="@drawable/arrow_circle_left_48px"
            tools:ignore="HardcodedText,VisualLintSystemUi" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_general_theme"
            style="?appTitleSpecialStyle"
            tools:ignore="VisualLintSystemUi" />

        <Space
            android:layout_width="56dp"
            android:layout_height="1dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_appearance_theme"
                style="?appTitleStyle" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="false"
                android:scrollbars="none"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/system_theme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        style="?appCardStyle">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="55dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="5dp"
                            android:paddingEnd="12dp"
                            android:paddingVertical="12dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="5dp"
                                android:contentDescription="@string/settings_appearance_theme_system"
                                android:src="@drawable/settings_48px"
                                style="?appImageStyle" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/settings_appearance_theme_system"
                                    android:text="@string/settings_appearance_theme_system"
                                    style="?appSubtitleStyle" />

                            </LinearLayout>

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/system_theme_radio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/light_theme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        style="?appCardStyle">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="55dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="5dp"
                            android:paddingEnd="12dp"
                            android:paddingVertical="12dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="5dp"
                                android:contentDescription="@string/settings_appearance_theme_light"
                                android:src="@drawable/light_mode_48px"
                                style="?appImageStyle" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:contentDescription="@string/settings_appearance_theme_light"
                                android:text="@string/settings_appearance_theme_light"
                                style="?appSubtitleStyle" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/light_theme_radio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/dark_theme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        style="?appCardStyle">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="55dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="5dp"
                            android:paddingEnd="12dp"
                            android:paddingVertical="12dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="5dp"
                                android:contentDescription="@string/settings_appearance_theme_dark"
                                android:src="@drawable/dark_mode_48px"
                                style="?appImageStyle" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:contentDescription="@string/settings_appearance_theme_dark"
                                android:text="@string/settings_appearance_theme_dark"
                                style="?appSubtitleStyle" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/dark_theme_radio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </HorizontalScrollView>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_appearance_scheme"
                style="?appTitleStyle" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="false"
                android:scrollbars="none"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/system_scheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        style="?appCardStyle">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="5dp"
                            android:paddingEnd="12dp"
                            android:paddingVertical="12dp">

                            <View
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="5dp"
                                android:background="@mipmap/ic_launcher" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_appearance_scheme_system"
                                style="?appSubtitleStyle" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/system_scheme_radio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/legacy_scheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        style="?appCardStyle">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="55dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="5dp"
                            android:paddingEnd="12dp"
                            android:paddingVertical="12dp">

                            <View
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="5dp"
                                android:background="@mipmap/ic_launcher" />

                            <com.google.android.material.textview.MaterialTextView
                                style="?appSubtitleStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_appearance_scheme_legacy" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/legacy_scheme_radio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/sky_scheme"
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        style="?appCardStyle">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="55dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="5dp"
                            android:paddingEnd="12dp"
                            android:paddingVertical="12dp">

                            <View
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="5dp"
                                android:background="@mipmap/ic_launcher" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_appearance_scheme_sky"
                                style="?appSubtitleStyle" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/sky_scheme_radio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </HorizontalScrollView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>