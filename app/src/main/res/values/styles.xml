<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Legacy -->
    <style name="Legacy.TextAppearance" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Legacy.TextAppearance.Title" parent="Legacy.TextAppearance">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Legacy.TextAppearance.Title.Center" parent="Legacy.TextAppearance.Title">
        <item name="android:gravity">center</item>
    </style>

    <style name="Legacy.TextAppearance.Title.Start" parent="Legacy.TextAppearance.Title">
        <item name="android:gravity">start</item>
    </style>

    <style name="Legacy.TextAppearance.Title.Special" parent="Legacy.TextAppearance.Title.Center">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Legacy.TextAppearance.Subtitle" parent="Legacy.TextAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Legacy.TextAppearance.Body" parent="Legacy.TextAppearance">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Legacy.TextAppearance.Caption" parent="Legacy.TextAppearance">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Legacy.Component.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?appButtonText</item>
        <item name="android:backgroundTint">?appButtonBackground</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">55dp</item>
        <item name="android:layout_marginHorizontal">8dp</item>
        <item name="android:layout_marginVertical">4dp</item>
        <item name="android:elevation">5dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Legacy.Component.ImageButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?appImageButtonIconTint</item>
        <!--<item name="backgroundTint">?appImageButtonBackground</item>-->
        <item name="iconSize">48dp</item>
        <item name="iconGravity">textStart</item>

        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:layout_margin">2dp</item>

        <!--<item name="android:elevation">4dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">12dp</item>-->
    </style>

    <style name="Legacy.Component.Image" parent="Legacy.Component.ImageButton">
        <item name="iconTint">@null</item>
    </style>

    <style name="Legacy.Component.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">?appTextInputLayoutBoxColor</item>
        <item name="boxBackgroundColor">?appTextInputLayoutBoxBackground</item>
        <item name="hintTextColor">?appTextInputLayoutBoxColor</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Legacy.Component.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">?editTextColor</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:paddingHorizontal">12dp</item>
    </style>

    <style name="Legacy.Component.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:textColor">?appCheckBoxColor</item>
        <item name="android:textSize">16sp</item>
        <item name="buttonTint">?appCheckBoxTint</item>
    </style>

    <style name="Legacy.Component.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardBackgroundColor">?appCardBackground</item>
        <item name="cardElevation">5dp</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Legacy.Component.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="background">?appTabLayoutBackground</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
        <item name="tabIndicatorColor">?appTabLayoutIndicator</item>
        <item name="tabSelectedTextColor">?appTabLayoutColor</item>
        <item name="tabTextColor">?appTabLayoutColor</item>
        <item name="tabTextAppearance">?appTitleStyle</item>
    </style>

    <style name="Legacy.Component.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">?appFabBackgroundTint</item>
        <item name="tint">?appFabTint</item>
    </style>

    <style name="Legacy.Component.Slider" parent="Widget.Material3.Slider">
        <item name="thumbColor">?appSliderThumbActive</item>
        <item name="thumbStrokeColor">?appSliderThumbInactive</item>
        <item name="trackColorActive">?appSliderTrackActive</item>
        <item name="trackColorInactive">?appSliderTrackInactive</item>
        <item name="haloColor">?appSliderHaloColor</item>
        <item name="tickColorActive">?appSliderTickActive</item>
        <item name="tickColorInactive">?appSliderTickInactive</item>
    </style>

    <style name="Legacy.Component.Dropdown" parent="Widget.Material3.AutoCompleteTextView.OutlinedBox">
        <item name="android:textColor">?appDropdownColor</item>
        <item name="dropDownBackgroundTint">?appDropdownBackgroundTint</item>
        <item name="simpleItemSelectedColor">?appDropdownBackgroundTint</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>
</resources>