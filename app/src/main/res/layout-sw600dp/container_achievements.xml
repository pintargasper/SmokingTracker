<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/achievement_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_achievement"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/achievements_icon"
        android:src="@mipmap/ic_launcher"
        android:scaleType="centerInside" />

    <LinearLayout
        android:id="@+id/achievement_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/achievement_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?appTitleStyle" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/achievement_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?appBodyStyle" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/achievement_meta_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/last_achieved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/achievement_last"
            style="?appBodyStyle"
            tools:ignore="VisualLintSystemUi" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_last_achieved_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/achieved_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/achievement_achieved"
            style="?appBodyStyle" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_achieved_count_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?appBodyStyle" />

    </LinearLayout>

</LinearLayout>